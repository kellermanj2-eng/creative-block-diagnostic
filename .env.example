# .env.example — copy to .env and fill in your values
# The app works with zero credentials; watsonx personalization is opt-in.

# ── watsonx (optional) ────────────────────────────────────────────────────────
# Set WATSONX_ENABLED=true to enable LLM-powered exercise personalisation.
# Leave as false (or omit) to run fully offline.
WATSONX_ENABLED=false

WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_DEBUG=false
